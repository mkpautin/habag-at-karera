DATABASE_URL=postgres://habag:change-me@localhost:5432/habag
# Optional direct PostgreSQL URL for migrations/seeding when DATABASE_URL uses a pooler.
# For Supabase: DATABASE_URL = Transaction pooler (6543); DIRECT_DATABASE_URL = Session pooler (5432).
# Copy both full URLs from Supabase's Connect dialog and include sslmode=require.
DIRECT_DATABASE_URL=
POSTGRES_PASSWORD=change-me
GROUP_1_PASSWORD=change-me
GROUP_2_PASSWORD=change-me
GROUP_3_PASSWORD=change-me
GROUP_4_PASSWORD=change-me
ADMIN_PASSWORD=change-me
IMAGE_REPOSITORY=ghcr.io/mkpautin/habag-at-karera
IMAGE_TAG=latest
APP_PORT=3000
